# Esempio di configurazione per lite_robot.sh
# Copia questo file come .headers.env e modifica i valori

# ==============================================
# AUTENTICAZIONE
# ==============================================
# Formato parametrizzato (nome_cookie=valore) - RACCOMANDATO
# Permette di specificare il nome del cookie insieme al valore
XSRF_TOKEN="XSRF-TOKEN=eyJpdiI6IlpPWTZYNWNzWm..."
SESSION_TOKEN="laravel_session=eyJpdiI6IlpPWTZYNWNz..."

# Formato legacy (solo valore) - ancora supportato
# XSRF_TOKEN="eyJpdiI6IlpPWTZYNWNz..."
# SESSION_TOKEN="eyJpdiI6IlpPWTZYNWNz..."

# ==============================================
# HEADERS HTTP
# ==============================================
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
ACCEPT="text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8"
ACCEPT_ENCODING="gzip, deflate, br, zstd"
ACCEPT_LANGUAGE="it-IT,it;q=0.9,en-US;q=0.8,en;q=0.7"
CONNECTION="keep-alive"
SEC_FETCH_DEST="document"
SEC_FETCH_MODE="navigate"
SEC_FETCH_SITE="same-origin"
SEC_FETCH_USER="?1"
UPGRADE_INSECURE_REQUESTS="1"
SEC_CH_UA="\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
SEC_CH_UA_MOBILE="?0"
SEC_CH_UA_PLATFORM="\"Windows\""

# ==============================================
# OPZIONI CURL
# ==============================================
CONNECT_TIMEOUT="15"
MAX_TIME="60"
INSECURE="true"
FOLLOW_REDIRECTS="true"
MAX_REDIRECTS="10"

# ==============================================
# CONFIGURAZIONE SCRIPT
# ==============================================
DEFAULT_DELAY="0.5"
DEFAULT_PARALLEL_JOBS="1"
MIN_LOG_LEVEL="INFO"
LOG_HEADERS="false"

# ==============================================
# ESEMPI PER DIVERSE APPLICAZIONI
# ==============================================

# Laravel/Sanctum:
# XSRF_TOKEN="XSRF-TOKEN=eyJ..."
# SESSION_TOKEN="laravel_session=eyJ..."

# WordPress:
# XSRF_TOKEN="wordpress_nonce=abc123..."
# SESSION_TOKEN="wordpress_logged_in_=abc123..."

# Symfony:
# XSRF_TOKEN="_csrf_token=abc123..."
# SESSION_TOKEN="PHPSESSID=abc123..."

# Django:
# XSRF_TOKEN="csrftoken=abc123..."
# SESSION_TOKEN="sessionid=abc123..."